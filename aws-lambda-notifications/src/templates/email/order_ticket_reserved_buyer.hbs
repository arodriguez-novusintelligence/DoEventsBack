<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}}</title>
  </head>
  <body style="margin:0;padding:24px;background:#f3f4f6;font-family:Arial,sans-serif;color:#111827;">
    <div style="max-width:560px;margin:0 auto;background:#fff;border-radius:12px;padding:24px;">
      <h1 style="margin:0 0 12px;font-size:22px;">Reserva de boletas</h1>
      <p style="margin:0 0 16px;line-height:1.5;">
        Hola {{buyerName}}, reservaste boletas para <strong>{{eventName}}</strong>.
        Tienes <strong>15 minutos</strong> para completar el pago o perderás la reserva.
      </p>
      {{#if seatLabels}}
      <p style="margin:0 0 16px;"><strong>Asientos:</strong> {{seatLabels}}</p>
      {{/if}}
      <p style="margin:0 0 16px;"><strong>Total:</strong> {{totalFormatted}}</p>
      <p style="margin:0 0 20px;font-size:13px;color:#6b7280;">
        Expira: {{expiresAt}}
      </p>
      <a href="{{paymentLink}}" style="display:inline-block;background:#5856EB;color:#fff;text-decoration:none;padding:12px 20px;border-radius:8px;font-weight:700;">
        Completar pago
      </a>
    </div>
  </body>
</html>
