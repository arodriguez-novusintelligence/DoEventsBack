- Usar geolocalización silenciosa cuando el permiso ya está concedido
- No reutilizar caché con nearby vacío si hay coordenadas del usuario
- Fallback apiRequest en fetchNearbyEvents ante fallo de fetch directo
- Mapear fechaFin en eventos del feed para filtros de descubrimiento
---
 packages/shared/src/api/eventsService.ts | 38 ++++++++++++++++--------
 packages/shared/src/lib/userLocation.ts  | 16 +++++++++-
 packages/shared/src/types/events.ts      |  1 +
 packages/shell/src/pages/EventsPage.tsx  |  1 +
 4 files changed, 43 insertions(+), 13 deletions(-)

diff --git a/packages/shared/src/api/eventsService.ts b/packages/shared/src/api/eventsService.ts
index 82e034f..7ce08a5 100644
--- a/packages/shared/src/api/eventsService.ts
+++ b/packages/shared/src/api/eventsService.ts
@@ -149,6 +149,7 @@ function mapRawEvent(raw: Record<string, unknown>): FeedEventItem {
     id: String(raw.id || ''),
     nombre: String(raw.nombre || raw.name || 'Evento'),
     fechaIni: raw.fechaIni as string | undefined,
+    fechaFin: raw.fechaFin as string | undefined,
     horaIni: raw.horaIni as string | undefined,
     ciudad: raw.ciudad as string | undefined,
     departamento: raw.departamento as string | undefined,
@@ -265,21 +266,34 @@ export async function fetchNearbyEvents(
     body: JSON.stringify(payload),
   });
 
-  if (!response.ok) {
+  const applyNearbyPrivacy = async (data: Record<string, unknown>): Promise<FeedEventItem[]> => {
+    const result = normalizeFeedResponse(data);
+    const { filterByOwnerPrivacy } = await import('../lib/privacyVisibility');
+    const visible = await filterByOwnerPrivacy(
+      result.items,
+      (item) => item.userId,
+      userId,
+    );
+    cacheEvents(visible);
+    return visible;
+  };
+
+  if (response.ok) {
+    const data = await response.json() as Record<string, unknown>;
+    return applyNearbyPrivacy(data);
+  }
+
+  try {
+    const data = await apiRequest<Record<string, unknown>>({
+      method: 'POST',
+      url: env.endpoints.eventsFeed,
+      data: payload,
+    });
+    return applyNearbyPrivacy(data);
+  } catch {
     const errText = await response.text().catch(() => '');
     throw new Error(errText || `Error al cargar eventos cercanos (${response.status})`);
   }
